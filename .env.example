# Local development. Hosted Render uses its dashboard environment values.
STOREPILOT_ENV=development
# Set to the browser origin when running the Vite dev server.
# STOREPILOT_ORIGIN=http://127.0.0.1:5173
# Neon connection string; copy it from the Neon console with SSL enabled.
# STOREPILOT_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'
# Generate an owner hash using the management command; never put a raw password here.
# STOREPILOT_OWNER_USERNAME=owner
# STOREPILOT_OWNER_PASSWORD_HASH='GENERATED_HASH'
# Optional free Groq key for reviewed shopping-list suggestions.
# GROQ_API_KEY='YOUR_GROQ_KEY'
# STOREPILOT_AI_MODEL=openai/gpt-oss-120b
