{
  "name": "storepilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write src *.ts *.json index.html public/*.{js,webmanifest}",
    "format:check": "prettier --check src *.ts *.json index.html public/*.{js,webmanifest}"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
